# Frontend Environment Configuration

# API Configuration
VITE_API_URL=http://localhost:5000/api

# Application Configuration
VITE_APP_NAME=Cyber Sentinel
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Features Configuration
VITE_ENABLE_REAL_TIME_MONITORING=true
VITE_ENABLE_SOCIAL_MEDIA_INTEGRATION=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_OFFLINE_DETECTION=true

# ML Model Configuration
VITE_ML_MODEL_UPDATE_INTERVAL=24
VITE_DETECTION_CACHE_TIMEOUT=300000

# UI Configuration
VITE_DEFAULT_DETECTION_SENSITIVITY=medium
VITE_MAX_DETECTION_HISTORY=1000
VITE_ENABLE_DARK_MODE=true