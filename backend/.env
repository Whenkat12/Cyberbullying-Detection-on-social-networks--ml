# Cyber Sentinel Backend Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/CyberGuard
DB_NAME=CyberGuard

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRE=30d

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,csv,json

# ML Model Configuration
MODEL_UPDATE_INTERVAL=24
MODEL_RETRAIN_THRESHOLD=1000

# Email Configuration (Optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@cybersentinel.com

# Social Media API Keys (Optional - for real integration)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=
INSTAGRAM_ACCESS_TOKEN=
WHATSAPP_BUSINESS_API_KEY=

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/CyberGuard.log

# Redis Configuration (Optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# WebSocket Configuration
WS_PORT=5001
MAX_CONNECTIONS=1000

# Admin Configuration
ADMIN_EMAIL=admin@cybersentinel.com
ADMIN_PASSWORD=admin123

# Feature Flags
ENABLE_REAL_TIME_MONITORING=true
ENABLE_SOCIAL_MEDIA_INTEGRATION=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_ANALYTICS=true